<Window x:Class="WpfTeam12.VictoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VictoryWindow" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Nieuw Bedrijf" Name="MnuNieuwBedrijf" Click="MnuItem_Click"/>
                <MenuItem Header="Nieuwe Gebruiker" Name="MnuNieuweGebruiker" Click="MnuItem_Click"/>
                <MenuItem Header="Nieuwe Inschrijving" Name="MnuNieuweInschrijving" Click="MnuItem_Click"/>
                <MenuItem Header="Nieuwe Job" Name="MnuNieuweJob" Click="MnuItem_Click"/>
                <MenuItem Header="Nieuwe Rol" Name="MnuNieuweRol" Click="MnuItem_Click"/>
                <MenuItem Header="Nieuwe Sollicitatie" Name="MnuNieuweSollicitatie" Click="MnuItem_Click"/>
                <MenuItem Header="Nieuwe Tijdslog" Name="MnuNieuweTijdslog" Click="MnuItem_Click"/>
                <MenuItem Header="Nieuwe Training" Name="MnuNieuweTraining" Click="MnuItem_Click"/>
                <MenuItem Header="Close" Click="MnuClose_Click"/>
            </MenuItem>
        </Menu>

        <!-- Dynamische ItemsControl -->
        <ItemsControl x:Name="MyItemsControl" DockPanel.Dock="Top" Margin="10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="10">
                        <!-- Label 1 -->
                        <WrapPanel Visibility="{Binding HasLabel1}" HorizontalAlignment="Center">
                            <Label Content="{Binding Label1}" Width="125"/>
                            <TextBox Text="{Binding Text1}" Margin="5" Width="125"/>
                        </WrapPanel>

                        <!-- Label 2 -->
                        <WrapPanel Visibility="{Binding HasLabel2}" HorizontalAlignment="Center">
                            <Label Content="{Binding Label2}" Width="125"/>
                            <TextBox Text="{Binding Text2}" Margin="5" Width="125"/>
                        </WrapPanel>

                        <!-- Label 3 -->
                        <WrapPanel Visibility="{Binding HasLabel3}" HorizontalAlignment="Center">
                            <Label Content="{Binding Label3}" Width="125"/>
                            <TextBox Text="{Binding Text3}" Margin="5" Width="125"/>
                        </WrapPanel>

                        <!-- Label 4 -->
                        <WrapPanel Visibility="{Binding HasLabel4}" HorizontalAlignment="Center">
                            <Label Content="{Binding Label4}" Width="125"/>
                            <TextBox Text="{Binding Text4}" Margin="5" Width="125"/>
                        </WrapPanel>

                        <!-- Label 5 -->
                        <WrapPanel Visibility="{Binding HasLabel5}" HorizontalAlignment="Center">
                            <Label Content="{Binding Label5}" Width="125"/>
                            <TextBox Text="{Binding Text5}" Margin="5" Width="125"/>
                        </WrapPanel>

                        <!-- Label 6 -->
                        <WrapPanel Visibility="{Binding HasLabel6}" HorizontalAlignment="Center">
                            <Label Content="{Binding Label6}" Width="125"/>
                            <TextBox Text="{Binding Text6}" Margin="5" Width="125"/>
                        </WrapPanel>

                        <!-- Label 7 -->
                        <WrapPanel Visibility="{Binding HasLabel7}" HorizontalAlignment="Center">
                            <Label Content="{Binding Label7}" Width="125"/>
                            <TextBox Text="{Binding Text7}" Margin="5" Width="125"/>
                        </WrapPanel>

                        <!-- Button -->
                        <!-- Button -->
                        <Button Content="{Binding ButtonText}" Width="125" Margin="5" Command="{Binding ButtonClick}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- DataGrid -->
        <DataGrid Name="DgdSql" Margin="10" AutoGenerateColumns="True"/>
    </DockPanel>
</Window>
